# ---------- Server ----------
PORT=5000
NODE_ENV=development            # use "production" when deployed
# TRUST_PROXY=1                 # set when behind a proxy / hosting platform (Render, Railway, nginx...)

# ---------- PayU ----------
PAYU_MERCHANT_KEY=your_payu_key
PAYU_MERCHANT_SALT=your_payu_salt
PAYU_MODE=test                  # "test" while developing, "live" only for real payments
PAYU_PRODUCT_INFO=ZomissCrownRegistration

# ---------- URLs ----------
# Public URL of THIS API. PayU posts the payment result here. (Required in production, must be HTTPS)
PUBLIC_BASE_URL=http://localhost:5000

# URL of your separately hosted FRONT-END. After payment the API redirects the browser here.
# Must be exactly the site the visitor filled the form on.
#   https://your-site.com            -> https://your-site.com/registration.html
#   http://127.0.0.1:5500/Front_end/ -> http://127.0.0.1:5500/Front_end/registration.html
FRONTEND_URL=http://127.0.0.1:5500/Front_end/

# Extra browsers allowed to call the API (comma separated origins). FRONTEND_URL is allowed automatically.
# ALLOWED_ORIGINS=https://www.your-site.com,https://your-site.com

# ---------- Optional ----------
# DATA_DIR=/var/data            # persistent folder for orders/registrations JSON
